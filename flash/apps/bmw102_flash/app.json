{
  "id": "bmw102_flash",
  "title": "BMW102 · Flash",
  "description": "Стробоскоп дальним светом и световое шоу как в Ambient config: полиция, запуск рычагом дальнего. Только частная территория.",
  "version": "0.4.0",
  "vendor": "custom",
  "loggingId": "FLSH",
  "iconGlyph": "ambient",
  "mguHmi": [
    "ID7",
    "ID8"
  ],
  "requires": {
    "idrive7-renderd": "2.1.18",
    "mgu-inputgate": "1.1.0"
  },
  "autostart": true,
  "signals": {
    "com.harman.infotainment.systemfunctions.tasu.tasu.InternalTasu": {
      "_instances": "SystemFunctionsInternalTasuInst1",
      "_methods": [
        "sendTasuRequest"
      ],
      "_broadcasts": [
        "sendTasuResponse"
      ]
    },
    "de.bmw.infrastructure.VehicleCondition": {
      "_optional": "закрыли и ушли: остановка",
      "VehicleCondition": "s",
      "vehicleConditionNoCrc": "s"
    },
    "de.bmw.infotainment.vehicle.Vehicle2": {
      "_optional": "скорость (шоу только стоя) и рычаг дальнего",
      "statusCarSpeed2": "rs",
      "statusLightStatus": "rs"
    }
  },
